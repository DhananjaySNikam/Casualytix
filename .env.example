# Optional. Leave unset for a private, entirely offline local classifier.
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini
# For a local OpenAI-compatible provider, e.g. Ollama:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2
# CAUSALYTIX_DATA=.data
# SESSION_SECRET=generate-a-long-random-server-secret-or-use-the-persisted-default
# To change ports, set PORT in the shell that launches npm run dev.
# Override the included public Supabase deployment at frontend build time.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
